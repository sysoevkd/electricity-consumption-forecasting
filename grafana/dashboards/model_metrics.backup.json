          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT CASE step_num WHEN 1 THEN '+15 мин' WHEN 2 THEN '+30 мин' WHEN 3 THEN '+45 мин' WHEN 4 THEN '+60 мин' END AS \"Горизонт\", COUNT(*) AS \"Точек\", round(AVG(abs_error)::numeric, 4) AS \"MAE\", round(SQRT(AVG(error^2))::numeric, 4) AS \"RMSE\", round((AVG(ABS(error / NULLIF(actual_value,0))) * 100)::numeric, 2) AS \"MAPE, %\", round(MIN(abs_error)::numeric, 4) AS \"Min ошибка\", round(MAX(abs_error)::numeric, 4) AS \"Max ошибка\" FROM backtest_cache GROUP BY step_num ORDER BY step_num",
          "refId": "A"
        }
      ],
      "title": "Сводная таблица точности по горизонтам",
      "type": "table"

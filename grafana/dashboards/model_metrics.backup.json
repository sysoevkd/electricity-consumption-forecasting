        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "editorMode": "raw",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT computed_at AS \"time\", AVG(ABS(error / NULLIF(actual_value,0)) * 100) FILTER (WHERE step_num=1) AS \"+15 мин\", AVG(ABS(error / NULLIF(actual_value,0)) * 100) FILTER (WHERE step_num=2) AS \"+30 мин\", AVG(ABS(error / NULLIF(actual_value,0)) * 100) FILTER (WHERE step_num=3) AS \"+45 мин\", AVG(ABS(error / NULLIF(actual_value,0)) * 100) FILTER (WHERE step_num=4) AS \"+60 мин\" FROM backtest_cache GROUP BY computed_at ORDER BY computed_at",
          "refId": "A"
        }
      ],
      "title": "MAPE по горизонту прогноза (%)",
      "type": "timeseries"
    },

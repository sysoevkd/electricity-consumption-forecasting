    {
      "datasource": { "type": "postgres", "uid": "postgres" },
      "description": "Ошибка committed прогноза: |факт − прогноз|. Только для точек где есть и committed прогноз, и фактическое значение.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "orange" },
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 70,
            "lineWidth": 1,
            "pointSize": 5,
            "showPoints": "never",
            "spanNulls": false
          },
          "decimals": 4,
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 36 },
      "id": 5,
      "options": {
        "legend": { "calcs": ["mean", "max"], "displayMode": "table", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "editorMode": "raw",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__time(fc.forecast_time), ABS(td.usage_kwh - fc.value_kwh) AS \"|Ошибка committed прогноза|\" FROM forecast_cache fc JOIN training_data td ON td.date = fc.forecast_time WHERE fc.is_committed = true AND $__timeFilter(fc.forecast_time) ORDER BY fc.forecast_time",
          "refId": "A"
        }
      ],
      "title": "Ошибка committed прогноза |Факт − Прогноз|",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "postgres", "uid": "postgres" },
      "gridPos": { "h": 5, "w": 24, "x": 0, "y": 43 },
      "id": 6,
      "options": { "showHeader": true },
      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "editorMode": "raw",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT fc.forecast_time AS \"Время\", round(fc.value_kwh::numeric,4) AS \"Committed прогноз\", round(td.usage_kwh::numeric,4) AS \"Факт\", round(ABS(td.usage_kwh - fc.value_kwh)::numeric,4) AS \"|Ошибка|\", round((ABS(td.usage_kwh - fc.value_kwh) / NULLIF(td.usage_kwh,0) * 100)::numeric,2) AS \"Ошибка, %\", fc.computed_at AS \"Прогноз сделан в\" FROM forecast_cache fc JOIN training_data td ON td.date = fc.forecast_time WHERE fc.is_committed = true ORDER BY fc.forecast_time DESC LIMIT 100",
          "refId": "A"
        }
      ],
      "title": "Таблица: committed прогноз vs факт",
      "type": "table"
    }

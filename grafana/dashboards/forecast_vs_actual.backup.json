          "rawSql": "SELECT point_time AS \"Время точки\", round(forecast_value::numeric,4) AS \"Прогноз, кВт·ч\", round(actual_value::numeric,4) AS \"Факт, кВт·ч\", round(error::numeric,4) AS \"Ошибка\", round(abs_error::numeric,4) AS \"|Ошибка|\" FROM backtest_cache WHERE step_num = 1 ORDER BY point_time DESC LIMIT 200",

          "rawQuery": true,
          "rawSql": "SELECT $__time(fc.forecast_time), fc.value_kwh AS \"Committed прогноз (+15 мин)\" FROM forecast_cache fc WHERE fc.is_committed = true AND $__timeFilter(fc.forecast_time) ORDER BY fc.forecast_time",
          "refId": "B"
        }
      ],
      "title": "Committed Forecast vs Факт (продовый цикл)",
      "type": "timeseries"

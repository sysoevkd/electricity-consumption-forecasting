      "targets": [
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "editorMode": "raw",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT $__time(td.date), td.usage_kwh AS \"Факт\" FROM training_data td WHERE $__timeFilter(td.date) ORDER BY td.date",
          "refId": "A"
        },
        {
          "datasource": { "type": "postgres", "uid": "postgres" },
          "editorMode": "raw",
